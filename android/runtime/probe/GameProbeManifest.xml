<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.lunetile.gameprobe">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <application android:label="Lunetile experimental game probe" android:extractNativeLibs="true">
        <activity android:name="org.lunetile.host.GameActivity" android:exported="true" android:process=":game" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
